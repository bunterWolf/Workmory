
        <!-- Microsoft Store package: start Missing Hours with Windows. Store apps cannot use the registry
             Run key (auto-launch); the user switches this task in Windows Settings > Startup apps. -->
        <desktop:Extension Category="windows.startupTask" Executable="app\Missing Hours.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MissingHoursStartup" Enabled="true" DisplayName="Missing Hours" />
        </desktop:Extension>
